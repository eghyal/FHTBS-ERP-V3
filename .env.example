# ===================================================================
# FHTBS ERP - Environment Configuration
# Salin file ini menjadi .env lalu isi nilainya sesuai environment.
# ===================================================================

# WAJIB untuk production: secret penandatanganan JWT sesi pengguna.
# Generate dengan: openssl rand -base64 48
JWT_SECRET=

# Port HTTP server (default: 3000)
PORT=3000

# Origin yang diizinkan untuk CORS (pisahkan dengan koma).
# Kosongkan untuk mengizinkan same-origin saja.
# Contoh: ALLOWED_ORIGINS=https://erp.example.com,https://www.example.com
ALLOWED_ORIGINS=

# Mode database hybrid: DUAL | FIRESTORE_ONLY | SQLITE_FALLBACK
# Tanpa kredensial Firebase, sistem otomatis memakai SQLITE_FALLBACK.
DB_MODE=

# --- Integrasi Firebase / Cloud Firestore (opsional) ---
# Diisi bila ingin mengaktifkan cloud sync, realtime listener,
# dan login Google pada B2C Shop.
# Untuk bundle client (Vite) gunakan prefix VITE_ pada key yang sama.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_FIRESTORE_DATABASE_ID=(default)

# --- PostgreSQL (opsional, replikasi data) ---
DATABASE_URL=

# --- Seeding akun inti (opsional) ---
# Kata sandi awal untuk akun god-mode yang dibuat SEKALI saat database baru.
# Tidak menimpa kata sandi yang sudah diganti pengguna. Segera ganti lewat
# menu "Change Password" setelah login pertama di environment produksi.
SEED_EGHY_PASSWORD=eghyalvandi
SEED_LUDY_PASSWORD=bachtiarludy
# Bila kosong, akun `admin` dibuat terkunci (kata sandi acak tak dikenal).
SEED_ADMIN_PASSWORD=

# --- Replika PostgreSQL (opsional, default: nonaktif) ---
# Isi 1 untuk mengaktifkan migrasi penuh ke PostgreSQL saat boot.
ENABLE_POSTGRES_REPLICA=0
